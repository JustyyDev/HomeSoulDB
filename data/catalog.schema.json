{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JustyyDev/HomeSoulDB/blob/main/data/catalog.schema.json",
  "title": "HomeSoulDB Catalog Entry",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "modId",
      "title",
      "status",
      "author",
      "description",
      "version",
      "category",
      "tags"
    ],
    "properties": {
      "modId": {
        "type": "string",
        "pattern": "^[a-z0-9_.-]+$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "type": "string"
      },
      "isWIP": {
        "type": "boolean"
      },
      "author": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "string"
      },
      "version": {
        "type": "string"
      },
      "category": {
        "type": "string"
      },
      "downloadUrl": {
        "type": "string"
      },
      "teaserUrl": {
        "type": "string"
      },
      "bannerUrl": {
        "type": "string"
      },
      "bumpCount": {
        "type": "integer",
        "minimum": 0
      },
      "streamerScore": {
        "type": "number"
      },
      "lastBumped": {
        "type": "number"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "boothText": {
        "type": "string",
        "maxLength": 84,
        "description": "Short in-world billboard copy for HomeSoul Cove showcase stands."
      },
      "boothTheme": {
        "type": "string",
        "description": "Visual vibe or stand theme used by the marketplace plaza."
      },
      "compatibleModes": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Supported runtime contexts such as singleplayer or plaza-multiplayer."
      },
      "supportsTextChat": {
        "type": "boolean"
      },
      "supportsVoiceChat": {
        "type": "boolean"
      },
      "supportsAvatarShowcase": {
        "type": "boolean"
      }
    },
    "additionalProperties": true
  }
}
